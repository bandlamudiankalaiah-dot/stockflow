# Copy to backend/.env and adjust for your environment.
# The backend loads this file automatically only when started with
# `uvicorn main:app` from the backend folder and python-dotenv is installed;
# alternatively export the variables in your shell / Render dashboard.

# PostgreSQL (Render / production). Omit to use SQLite locally.
# postgres:// URLs from Render are normalised automatically.
DATABASE_URL=postgresql://stockflow:stockflow@localhost:5432/stockflow

# Secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Token lifetime in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default low-stock threshold used for new organizations / products without one
DEFAULT_LOW_STOCK_THRESHOLD=5

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002,http://127.0.0.1:3002
